import java.util.*;

class Solution {
    public double averageWaitingTime(int[][] customers) {
        long currentFinishTime = 0;
        long totalWait = 0;

        for (int[] customer : customers) {
            int arrival = customer[0];
            int time = customer[1];

            long startTime = Math.max(arrival, currentFinishTime);
            long finishTime = startTime + time;

            totalWait += finishTime - arrival;
            currentFinishTime = finishTime;
        }

        return (double) totalWait / customers.length;
    }
}
