class Solution {
    public boolean exist(char[][] board, String word) {
        int rows = board.length;
        int cols = board[0].length;

        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                if (backtrack(board, word, r, c, 0, rows, cols)) {
                    return true;
                }
            }
        }

        return false;
    }

    private boolean backtrack(char[][] board, String word, int r, int c,
                              int index, int rows, int cols) {

        if (index == word.length()) {
            return true;
        }

        if (r < 0 || r >= rows ||
            c < 0 || c >= cols ||
            board[r][c] != word.charAt(index)) {
            return false;
        }

        char temp = board[r][c];
        board[r][c] = '#';

        boolean found =
            backtrack(board, word, r + 1, c, index + 1, rows, cols) ||
            backtrack(board, word, r - 1, c, index + 1, rows, cols) ||
            backtrack(board, word, r, c + 1, index + 1, rows, cols) ||
            backtrack(board, word, r, c - 1, index + 1, rows, cols);

        board[r][c] = temp;

        return found;
    }
}
