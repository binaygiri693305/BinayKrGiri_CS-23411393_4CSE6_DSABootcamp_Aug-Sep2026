class Solution {
    public Node flatten(Node head) {
        if (head == null) {
            return head;
        }

        Node curr = head;

        while (curr != null) {
            if (curr.child != null) {
                Node nextNode = curr.next;

                Node child = flatten(curr.child);

                curr.next = child;
                child.prev = curr;
                curr.child = null;

                Node last = child;

                while (last.next != null) {
                    last = last.next;
                }

                last.next = nextNode;

                if (nextNode != null) {
                    nextNode.prev = last;
                }
            }

            curr = curr.next;
        }

        return head;
    }
}
